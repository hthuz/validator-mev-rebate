
EPOCHS_PATH=/home/autentico/solana-validator/epochs
SAM_PATH=/home/autentico/ds-sam-pipeline
COLLECT_WORKER=1
MYSQL_ENGINE=mysql+pymysql://root:password@localhost/validator

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_UESR=sol
CLICKHOUSE_PASSWORD=sol
CLICKHOUSE_DBNAME=solwich

SANDWICH_PATH=/home/autentico/detection/data/labels/label.csv
BLOCK_PATH=/home/autentico/detection/data/processed/

# Mitigation: replay 数据源 block / victim，以及 victim 模式取数的 epoch
MITIGATION_TX_SOURCE=victim
MITIGATION_REPLAY_EPOCH=802

# Mitigation: slot 范围（inclusive，slot 就是 block），每次推进 +1
MITIGATION_START_SLOT=346769956
MITIGATION_END_SLOT=346769956

# Mitigation: 发送策略 immediate / delayed / risk-aware（代码默认 immediate）
MITIGATION_STRATEGY=risk-aware
MITIGATION_DELAY_SLOTS=1

# Mitigation: 历史 sandwich ratio 范围（800-801 的历史数据用于路由 epoch 802）
SANDWICH_HISTORY_START_EPOCH=800
SANDWICH_HISTORY_END_EPOCH=801
SANDWICH_RATIO_THRESHOLD=0.5
MITIGATION_MAX_SKIP_SLOTS=10

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Debug mode (true/false)
DEBUG_MODE=true
